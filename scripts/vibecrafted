cmd_telemetry_help() {
  printf '\n'
  printf '%b⚒%b  %btelemetry%b\n' "$_copper" "$_reset" "$_bold" "$_reset"
  printf '%b─────────────────────────────────────────%b\n' "$_steel" "$_reset"
