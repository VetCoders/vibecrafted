#!/bin/sh
set -eu

action=${1:-toggle}
runtime_root=${VIBECRAFTED_RUNTIME_ROOT:?VIBECRAFTED_RUNTIME_ROOT is required}
config_home=${XDG_CONFIG_HOME:-${HOME:?HOME is required}/.config}
theme_dir=${runtime_root}/config/vc-terminal/themes
product_dir=${config_home}/vibecrafted
active_theme=${product_dir}/terminal-theme.toml
# vc-frame's product-owned config (the copy Vibecrafted.app publishes once per
# install). Its static `theme "..."` is what a NEW session starts with: the
# terminal does not answer CSI 2031/DSR 997, so theme_dark/theme_light never
# auto-switch and a light host palette used to come up under monochrome ink —
# grey plugin text on ivory paper at every fresh vc-start (4.2.4 first run).
frame_config=${VC_FRAME_CONFIG_DIR:-${product_dir}/vc-frame}/config.kdl

frame_theme_for() {
    case $1 in
        light) printf '%s\n' vibecrafted-ivory ;;
        *) printf '%s\n' monochrome ;;
    esac
}

# persist_frame_theme <light|dark> — rewrite the top-level `theme "..."` line
# of the product config so the next session starts in the same mode the host
# palette is in. Only that one line changes; a config without the line gets it
# appended. Missing config = nothing to persist (attach-only hosts).
persist_frame_theme() {
    frame_theme=$(frame_theme_for "$1")
    test -f "$frame_config" || return 0
    frame_tmp=$(mktemp "${frame_config}.XXXXXX") || return 1
    if grep -q '^theme "' "$frame_config"; then
        sed "s/^theme \"[^\"]*\"/theme \"${frame_theme}\"/" "$frame_config" > "$frame_tmp"
    else
        cat "$frame_config" > "$frame_tmp"
        printf 'theme "%s"\n' "$frame_theme" >> "$frame_tmp"
    fi
    if mv -f "$frame_tmp" "$frame_config"; then
        return 0
    fi
    rm -f -- "$frame_tmp"
    return 1
}

theme_name() {
    if grep -q 'background = "#fafafa"' "$active_theme" 2>/dev/null; then
        printf '%s\n' light
    else
        printf '%s\n' dark
    fi
}

publish_theme() {
    name=$1
    previous=$(theme_name)
    source=${theme_dir}/${name}.toml
    test -f "$source" || {
        printf 'vc-theme: missing signed palette: %s\n' "$source" >&2
        exit 1
    }

    # Switch the frame first. Publishing the host palette before vc-frame
    # accepted the same mode briefly exposed light terminal paper behind dark
    # plugin ink when session routing failed. Some terminal file watchers also
    # missed the immediate rollback, leaving the product split until restart.
    if test -n "${ZELLIJ_SESSION_NAME:-}"; then
        if ! vc-frame --session "$ZELLIJ_SESSION_NAME" action "set-${name}-theme" >/dev/null; then
            printf 'vc-theme: vc-frame rejected %s theme; host palette remains %s\n' \
                "$name" "$previous" >&2
            return 1
        fi
    fi

    umask 077
    mkdir -p "$product_dir"
    temporary=$(mktemp "${product_dir}/.terminal-theme.XXXXXX")
    trap 'rm -f -- "$temporary"' EXIT HUP INT TERM
    if ! cp "$source" "$temporary" || \
        ! chmod 0600 "$temporary" || \
        ! mv -f "$temporary" "$active_theme"; then
        rm -f -- "$temporary"
        trap - EXIT HUP INT TERM
        if test -n "${ZELLIJ_SESSION_NAME:-}"; then
            vc-frame --session "$ZELLIJ_SESSION_NAME" \
                action "set-${previous}-theme" >/dev/null 2>&1 || true
        fi
        printf 'vc-theme: failed to publish %s host palette; vc-frame restored to %s\n' \
            "$name" "$previous" >&2
        return 1
    fi
    trap - EXIT HUP INT TERM
    if ! persist_frame_theme "$name"; then
        printf 'vc-theme: host palette is %s but vc-frame config could not be updated (%s); next session starts in the previous frame theme\n' \
            "$name" "$frame_config" >&2
    fi
    printf '%s\n' "$name"
}

case "$action" in
    current)
        theme_name
        ;;
    light|dark)
        publish_theme "$action"
        ;;
    toggle)
        if test "$(theme_name)" = dark; then
            publish_theme light
        else
            publish_theme dark
        fi
        ;;
    *)
        printf 'usage: vc-theme [current|toggle|light|dark]\n' >&2
        exit 2
        ;;
esac
