{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io.vetcoders.vibecrafted.contracts.v1",
  "title": "Unified Vibecrafted Product Contracts v1",
  "description": "Fail-closed manifests for unsigned modules, the assembled app, atomic activation, and the mounted-DMG walk-around.",
  "oneOf": [
    { "$ref": "#/$defs/moduleManifest" },
    { "$ref": "#/$defs/assemblyReceipt" },
    { "$ref": "#/$defs/productManifest" },
    { "$ref": "#/$defs/transactionReceipt" },
    { "$ref": "#/$defs/releaseOutput" },
    { "$ref": "#/$defs/walkaroundReceipt" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "x-vibecrafted-canonicalRelativePath": true
    },
    "architecture": {
      "const": "arm64"
    },
    "minimumMacos": {
      "type": "string",
      "pattern": "^(?:1[4-9]|[2-9][0-9])\\.[0-9]+$"
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "mode", "kind", "size", "dylibs"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mode": {
          "type": "string",
          "pattern": "^0[0-7]{3}$"
        },
        "kind": {
          "enum": ["executable", "dylib", "resource", "config"]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "dylibs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "moduleManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "module",
        "version",
        "git_sha",
        "dirty",
        "architecture",
        "minimum_macos",
        "files",
        "entrypoints"
      ],
      "properties": {
        "schema": {
          "const": "io.vetcoders.vibecrafted.module.v1"
        },
        "module": {
          "enum": ["vc-terminal", "vc-frame"]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "git_sha": { "$ref": "#/$defs/gitSha" },
        "dirty": { "type": "boolean" },
        "architecture": { "$ref": "#/$defs/architecture" },
        "minimum_macos": { "$ref": "#/$defs/minimumMacos" },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-vibecrafted-uniqueKeys": ["path"],
          "items": { "$ref": "#/$defs/fileEntry" }
        },
        "entrypoints": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "terminal": { "$ref": "#/$defs/relativePath" },
            "frame": { "$ref": "#/$defs/relativePath" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "module": { "const": "vc-terminal" } },
            "required": ["module"]
          },
          "then": {
            "properties": { "entrypoints": { "required": ["terminal"] } }
          }
        },
        {
          "if": {
            "properties": { "module": { "const": "vc-frame" } },
            "required": ["module"]
          },
          "then": {
            "properties": { "entrypoints": { "required": ["frame"] } }
          }
        }
      ]
    },
    "signedFileTransformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_path",
        "product_path",
        "unsigned_sha256",
        "product_sha256",
        "transformation"
      ],
      "properties": {
        "module_path": { "$ref": "#/$defs/relativePath" },
        "product_path": { "$ref": "#/$defs/relativePath" },
        "unsigned_sha256": { "$ref": "#/$defs/sha256" },
        "product_sha256": { "$ref": "#/$defs/sha256" },
        "transformation": { "enum": ["identity", "codesign"] }
      }
    },
    "assemblyReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "module", "module_manifest_sha256", "files"],
      "properties": {
        "schema": {
          "const": "io.vetcoders.vibecrafted.module-assembly.v1"
        },
        "module": {
          "enum": ["vc-terminal", "vc-frame"]
        },
        "module_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-vibecrafted-uniqueKeys": ["module_path", "product_path"],
          "items": { "$ref": "#/$defs/signedFileTransformation" }
        }
      }
    },
    "moduleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "manifest_path",
        "manifest_sha256",
        "assembly_receipt_path",
        "assembly_receipt_sha256",
        "git_sha"
      ],
      "properties": {
        "module": {
          "enum": ["vc-terminal", "vc-frame"]
        },
        "manifest_path": { "$ref": "#/$defs/relativePath" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "assembly_receipt_path": { "$ref": "#/$defs/relativePath" },
        "assembly_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "git_sha": { "$ref": "#/$defs/gitSha" }
      }
    },
    "outerBundleCode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "path",
        "mode",
        "kind",
        "architecture",
        "minimum_macos",
        "dylibs",
        "code_identity",
        "code_sha256",
        "info_plist_sha256",
        "codesign_identifier"
      ],
      "properties": {
        "identity": { "const": "outer-bundle-codesign-v1" },
        "path": { "const": "Contents/MacOS/Vibecrafted" },
        "mode": { "type": "string", "pattern": "^0[0-7]{3}$" },
        "kind": { "const": "executable" },
        "architecture": { "$ref": "#/$defs/architecture" },
        "minimum_macos": { "$ref": "#/$defs/minimumMacos" },
        "dylibs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "code_identity": { "const": "macho-code-v1" },
        "code_sha256": { "$ref": "#/$defs/sha256" },
        "info_plist_sha256": { "$ref": "#/$defs/sha256" },
        "codesign_identifier": { "const": "io.vetcoders.vibecrafted" }
      }
    },
    "launchContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "program", "argv", "config_path", "shell", "environment"],
      "properties": {
        "schema": { "const": "io.vetcoders.vibecrafted.launch.v1" },
        "program": { "const": "Contents/Helpers/vc-terminal" },
        "argv": {
          "const": [
            "--config-file",
            "Contents/Resources/terminal/vibecrafted.toml",
            "-e",
            "Contents/Resources/runtime/bin/vc-start",
            "operator"
          ]
        },
        "config_path": { "const": "Contents/Resources/terminal/vibecrafted.toml" },
        "shell": {
          "type": "object",
          "additionalProperties": false,
          "required": ["program", "argv"],
          "properties": {
            "program": { "const": "Contents/Resources/runtime/bin/vc-start" },
            "argv": { "const": ["operator"] }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resolver_inputs",
            "inherit_exact",
            "inject_literal",
            "inject_bundle_paths",
            "resolve_writable"
          ],
          "properties": {
            "resolver_inputs": { "const": ["VIBECRAFTED_RUNTIME_HOME", "XDG_DATA_HOME"] },
            "inherit_exact": {
              "const": [
                "HOME", "USER", "LOGNAME", "LANG", "LC_ALL", "LC_CTYPE",
                "TERM", "COLORTERM", "TMPDIR", "SHELL"
              ]
            },
            "inject_literal": {
              "const": { "PATH": "/usr/bin:/bin:/usr/sbin:/sbin" }
            },
            "inject_bundle_paths": {
              "const": {
                "VIBECRAFTED_APP_ROOT": ".",
                "VIBECRAFTED_VC_FRAME_BIN": "Contents/Helpers/vc-frame"
              }
            },
            "resolve_writable": {
              "const": {
                "VIBECRAFTED_RUNTIME_HOME": {
                  "source_order": [
                    "env:VIBECRAFTED_RUNTIME_HOME",
                    "env:XDG_DATA_HOME+rel:vibecrafted",
                    "env:HOME+rel:.local/share/vibecrafted"
                  ],
                  "must_be_absolute": true,
                  "must_be_writable_or_creatable": true,
                  "must_not_descend_from": "$APP_BUNDLE",
                  "publish_to_env": "VIBECRAFTED_RUNTIME_HOME"
                }
              }
            }
          }
        }
      }
    },
    "productManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "product",
        "bundle_id",
        "bundle_executable",
        "version",
        "build",
        "git_sha",
        "dirty",
        "architecture",
        "minimum_macos",
        "modules",
        "outer_bundle_code",
        "files",
        "entrypoints",
        "launch_contract"
      ],
      "properties": {
        "schema": {
          "const": "io.vetcoders.vibecrafted.product.v1"
        },
        "product": { "const": "Vibecrafted" },
        "bundle_id": { "const": "io.vetcoders.vibecrafted" },
        "bundle_executable": { "const": "Vibecrafted" },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "git_sha": { "$ref": "#/$defs/gitSha" },
        "dirty": { "type": "boolean" },
        "architecture": { "$ref": "#/$defs/architecture" },
        "minimum_macos": { "$ref": "#/$defs/minimumMacos" },
        "modules": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "x-vibecrafted-uniqueKeys": [
            "module",
            "manifest_path",
            "assembly_receipt_path"
          ],
          "items": { "$ref": "#/$defs/moduleBinding" },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": { "module": { "const": "vc-terminal" } },
                "required": ["module"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "module": { "const": "vc-frame" } },
                "required": ["module"]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "outer_bundle_code": { "$ref": "#/$defs/outerBundleCode" },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-vibecrafted-uniqueKeys": ["path"],
          "items": { "$ref": "#/$defs/fileEntry" }
        },
        "entrypoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["app", "terminal", "frame"],
          "properties": {
            "app": { "$ref": "#/$defs/relativePath" },
            "terminal": { "$ref": "#/$defs/relativePath" },
            "frame": { "$ref": "#/$defs/relativePath" }
          }
        },
        "launch_contract": { "$ref": "#/$defs/launchContract" }
      }
    },
    "productIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "manifest_path",
        "product_manifest_sha256",
        "source_revision"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "manifest_path": { "$ref": "#/$defs/relativePath" },
        "product_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "source_revision": { "$ref": "#/$defs/gitSha" }
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "manifest_path",
        "runtime_manifest_sha256",
        "source_revision"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "manifest_path": { "$ref": "#/$defs/relativePath" },
        "runtime_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "source_revision": { "$ref": "#/$defs/gitSha" }
      }
    },
    "releasePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "app", "runtime"],
      "properties": {
        "state": { "const": "present" },
        "app": { "$ref": "#/$defs/productIdentity" },
        "runtime": { "$ref": "#/$defs/runtimeIdentity" }
      }
    },
    "releaseAbsent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": { "state": { "const": "absent" } }
    },
    "releaseState": {
      "oneOf": [
        { "$ref": "#/$defs/releasePair" },
        { "$ref": "#/$defs/releaseAbsent" }
      ]
    },
    "transactionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "transaction_id",
        "previous",
        "new",
        "active",
        "outcome"
      ],
      "properties": {
        "schema": {
          "const": "io.vetcoders.vibecrafted.transaction.v1"
        },
        "transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "previous": { "$ref": "#/$defs/releaseState" },
        "new": { "$ref": "#/$defs/releasePair" },
        "active": { "$ref": "#/$defs/releaseState" },
        "outcome": {
          "enum": ["activated", "rolled_back"]
        }
      }
    },
    "proofArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 }
      }
    },
    "walkaroundProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "probe_id",
        "command",
        "exit_code",
        "inputs",
        "before",
        "after",
        "stdout",
        "stderr"
      ],
      "properties": {
        "producer": { "const": "vc-ship" },
        "probe_id": {
          "type": "string",
          "pattern": "^io\\.vetcoders\\.vibecrafted\\.walkaround\\.[a-z_]+\\.v1$"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "exit_code": { "const": 0 },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["release_output_sha256"],
          "properties": {
            "release_output_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "before": { "$ref": "#/$defs/proofArtifact" },
        "after": { "$ref": "#/$defs/proofArtifact" },
        "stdout": { "$ref": "#/$defs/proofArtifact" },
        "stderr": { "$ref": "#/$defs/proofArtifact" }
      }
    },
    "walkaroundProofs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_app",
        "codesign",
        "app_notarization",
        "dmg_notarization",
        "gatekeeper",
        "sanitized_launch",
        "mission_control",
        "bundled_console",
        "start_here",
        "update",
        "rollback",
        "reattach",
        "one_outer_writer"
      ],
      "properties": {
        "one_app": { "$ref": "#/$defs/walkaroundProof" },
        "codesign": { "$ref": "#/$defs/walkaroundProof" },
        "app_notarization": { "$ref": "#/$defs/walkaroundProof" },
        "dmg_notarization": { "$ref": "#/$defs/walkaroundProof" },
        "gatekeeper": { "$ref": "#/$defs/walkaroundProof" },
        "sanitized_launch": { "$ref": "#/$defs/walkaroundProof" },
        "mission_control": { "$ref": "#/$defs/walkaroundProof" },
        "bundled_console": { "$ref": "#/$defs/walkaroundProof" },
        "start_here": { "$ref": "#/$defs/walkaroundProof" },
        "update": { "$ref": "#/$defs/walkaroundProof" },
        "rollback": { "$ref": "#/$defs/walkaroundProof" },
        "reattach": { "$ref": "#/$defs/walkaroundProof" },
        "one_outer_writer": { "$ref": "#/$defs/walkaroundProof" }
      }
    },
    "trustedRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation", "signature"],
      "properties": {
        "attestation": { "$ref": "#/$defs/proofArtifact" },
        "signature": { "$ref": "#/$defs/proofArtifact" }
      }
    },
    "releaseModuleIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "assembly_receipt_sha256"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "assembly_receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "releaseOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "product_manifest_sha256",
        "outer_executable",
        "code_resources_sha256",
        "dmg",
        "modules",
        "source_revisions"
      ],
      "properties": {
        "schema": { "const": "io.vetcoders.vibecrafted.release-output.v1" },
        "product_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "outer_executable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256", "code_sha256", "cdhash", "team_id",
            "designated_requirement", "hardened_runtime", "entitlements"
          ],
          "properties": {
            "sha256": { "$ref": "#/$defs/sha256" },
            "code_sha256": { "$ref": "#/$defs/sha256" },
            "cdhash": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
            "team_id": { "const": "MW223P3NPX" },
            "designated_requirement": {
              "const": "identifier \"io.vetcoders.vibecrafted\" and anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] exists and certificate leaf[field.1.2.840.113635.100.6.1.13] exists and certificate leaf[subject.OU] = \"MW223P3NPX\""
            },
            "hardened_runtime": { "const": true },
            "entitlements": { "const": {} }
          }
        },
        "code_resources_sha256": { "$ref": "#/$defs/sha256" },
        "dmg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "size"],
          "properties": {
            "sha256": { "$ref": "#/$defs/sha256" },
            "size": { "type": "integer", "minimum": 1 }
          }
        },
        "modules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vc-terminal", "vc-frame"],
          "properties": {
            "vc-terminal": { "$ref": "#/$defs/releaseModuleIdentity" },
            "vc-frame": { "$ref": "#/$defs/releaseModuleIdentity" }
          }
        },
        "source_revisions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vibecrafted", "vc-terminal", "vc-frame"],
          "properties": {
            "vibecrafted": { "$ref": "#/$defs/gitSha" },
            "vc-terminal": { "$ref": "#/$defs/gitSha" },
            "vc-frame": { "$ref": "#/$defs/gitSha" }
          }
        }
      }
    },
    "walkaroundReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "dmg_path",
        "mount_path",
        "app_path",
        "release_output",
        "release_signature",
        "proofs",
        "trusted_runner",
        "delivery_seal"
      ],
      "properties": {
        "schema": {
          "const": "io.vetcoders.vibecrafted.walkaround.v1"
        },
        "dmg_path": {
          "type": "string",
          "pattern": "^/"
        },
        "mount_path": {
          "type": "string",
          "pattern": "^/"
        },
        "app_path": {
          "type": "string",
          "pattern": "^/"
        },
        "release_output": { "$ref": "#/$defs/proofArtifact" },
        "release_signature": { "$ref": "#/$defs/proofArtifact" },
        "proofs": { "$ref": "#/$defs/walkaroundProofs" },
        "trusted_runner": { "$ref": "#/$defs/trustedRunner" },
        "delivery_seal": { "$ref": "#/$defs/proofArtifact" }
      }
    }
  }
}
