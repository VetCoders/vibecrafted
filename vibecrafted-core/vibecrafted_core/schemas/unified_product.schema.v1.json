{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io.vetcoders.vibecrafted.contracts.v1",
  "title": "Unified Vibecrafted Product Contracts v1",
  "description": "Fail-closed manifests for unsigned modules, the assembled app, atomic activation, and the mounted-DMG walk-around.",
  "oneOf": [
    { "$ref": "#/$defs/moduleManifest" },
    { "$ref": "#/$defs/assemblyReceipt" },
    { "$ref": "#/$defs/productManifest" },
    { "$ref": "#/$defs/transactionReceipt" },
    { "$ref": "#/$defs/walkaroundReceipt" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "architecture": {
      "const": "arm64"
    },
    "minimumMacos": {
      "type": "string",
      "pattern": "^(?:1[4-9]|[2-9][0-9])\\.[0-9]+$"
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "mode", "kind", "size", "dylibs"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mode": {
          "type": "string",
          "pattern": "^0[0-7]{3}$"
        },
        "kind": {
          "enum": ["executable", "dylib", "resource", "config"]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "dylibs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "moduleManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "module",
        "version",
        "git_sha",
        "dirty",
        "architecture",
        "minimum_macos",
        "files",
        "entrypoints"
      ],
      "properties": {
        "schema": {
          "const": "io.vetcoders.vibecrafted.module.v1"
        },
        "module": {
          "enum": ["vc-terminal", "vc-frame"]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "git_sha": { "$ref": "#/$defs/gitSha" },
        "dirty": { "type": "boolean" },
        "architecture": { "$ref": "#/$defs/architecture" },
        "minimum_macos": { "$ref": "#/$defs/minimumMacos" },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-vibecrafted-uniqueKeys": ["path"],
          "items": { "$ref": "#/$defs/fileEntry" }
        },
        "entrypoints": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "terminal": { "$ref": "#/$defs/relativePath" },
            "frame": { "$ref": "#/$defs/relativePath" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "module": { "const": "vc-terminal" } },
            "required": ["module"]
          },
          "then": {
            "properties": { "entrypoints": { "required": ["terminal"] } }
          }
        },
        {
          "if": {
            "properties": { "module": { "const": "vc-frame" } },
            "required": ["module"]
          },
          "then": {
            "properties": { "entrypoints": { "required": ["frame"] } }
          }
        }
      ]
    },
    "signedFileTransformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_path",
        "product_path",
        "unsigned_sha256",
        "product_sha256",
        "transformation"
      ],
      "properties": {
        "module_path": { "$ref": "#/$defs/relativePath" },
        "product_path": { "$ref": "#/$defs/relativePath" },
        "unsigned_sha256": { "$ref": "#/$defs/sha256" },
        "product_sha256": { "$ref": "#/$defs/sha256" },
        "transformation": { "enum": ["identity", "codesign"] }
      }
    },
    "assemblyReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "module", "module_manifest_sha256", "files"],
      "properties": {
        "schema": {
          "const": "io.vetcoders.vibecrafted.module-assembly.v1"
        },
        "module": {
          "enum": ["vc-terminal", "vc-frame"]
        },
        "module_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-vibecrafted-uniqueKeys": ["module_path", "product_path"],
          "items": { "$ref": "#/$defs/signedFileTransformation" }
        }
      }
    },
    "moduleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "manifest_path",
        "manifest_sha256",
        "assembly_receipt_path",
        "assembly_receipt_sha256",
        "git_sha"
      ],
      "properties": {
        "module": {
          "enum": ["vc-terminal", "vc-frame"]
        },
        "manifest_path": { "$ref": "#/$defs/relativePath" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "assembly_receipt_path": { "$ref": "#/$defs/relativePath" },
        "assembly_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "git_sha": { "$ref": "#/$defs/gitSha" }
      }
    },
    "productManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "product",
        "bundle_id",
        "bundle_executable",
        "version",
        "build",
        "git_sha",
        "dirty",
        "architecture",
        "minimum_macos",
        "modules",
        "files",
        "entrypoints"
      ],
      "properties": {
        "schema": {
          "const": "io.vetcoders.vibecrafted.product.v1"
        },
        "product": { "const": "Vibecrafted" },
        "bundle_id": { "const": "io.vetcoders.vibecrafted" },
        "bundle_executable": { "const": "Vibecrafted" },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "git_sha": { "$ref": "#/$defs/gitSha" },
        "dirty": { "type": "boolean" },
        "architecture": { "$ref": "#/$defs/architecture" },
        "minimum_macos": { "$ref": "#/$defs/minimumMacos" },
        "modules": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "x-vibecrafted-uniqueKeys": [
            "module",
            "manifest_path",
            "assembly_receipt_path"
          ],
          "items": { "$ref": "#/$defs/moduleBinding" },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": { "module": { "const": "vc-terminal" } },
                "required": ["module"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "module": { "const": "vc-frame" } },
                "required": ["module"]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-vibecrafted-uniqueKeys": ["path"],
          "items": { "$ref": "#/$defs/fileEntry" }
        },
        "entrypoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["app", "terminal", "frame"],
          "properties": {
            "app": { "$ref": "#/$defs/relativePath" },
            "terminal": { "$ref": "#/$defs/relativePath" },
            "frame": { "$ref": "#/$defs/relativePath" }
          }
        }
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "source_revision"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_revision": { "$ref": "#/$defs/gitSha" }
      }
    },
    "releasePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "runtime"],
      "properties": {
        "app": { "$ref": "#/$defs/artifactIdentity" },
        "runtime": { "$ref": "#/$defs/artifactIdentity" }
      }
    },
    "transactionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "transaction_id",
        "previous",
        "new",
        "active",
        "outcome"
      ],
      "properties": {
        "schema": {
          "const": "io.vetcoders.vibecrafted.transaction.v1"
        },
        "transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "previous": { "$ref": "#/$defs/releasePair" },
        "new": { "$ref": "#/$defs/releasePair" },
        "active": { "$ref": "#/$defs/releasePair" },
        "outcome": {
          "enum": ["activated", "rolled_back"]
        }
      }
    },
    "proofArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 }
      }
    },
    "walkaroundProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "probe_id",
        "command",
        "exit_code",
        "inputs",
        "before",
        "after",
        "stdout",
        "stderr"
      ],
      "properties": {
        "producer": { "const": "vc-ship" },
        "probe_id": {
          "type": "string",
          "pattern": "^io\\.vetcoders\\.vibecrafted\\.walkaround\\.[a-z_]+\\.v1$"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "exit_code": { "const": 0 },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dmg_sha256", "product_manifest_sha256"],
          "properties": {
            "dmg_sha256": { "$ref": "#/$defs/sha256" },
            "product_manifest_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "before": { "$ref": "#/$defs/proofArtifact" },
        "after": { "$ref": "#/$defs/proofArtifact" },
        "stdout": { "$ref": "#/$defs/proofArtifact" },
        "stderr": { "$ref": "#/$defs/proofArtifact" }
      }
    },
    "walkaroundProofs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_app",
        "codesign",
        "app_notarization",
        "dmg_notarization",
        "gatekeeper",
        "sanitized_launch",
        "mission_control",
        "bundled_console",
        "start_here",
        "update",
        "rollback",
        "reattach",
        "one_outer_writer"
      ],
      "properties": {
        "one_app": { "$ref": "#/$defs/walkaroundProof" },
        "codesign": { "$ref": "#/$defs/walkaroundProof" },
        "app_notarization": { "$ref": "#/$defs/walkaroundProof" },
        "dmg_notarization": { "$ref": "#/$defs/walkaroundProof" },
        "gatekeeper": { "$ref": "#/$defs/walkaroundProof" },
        "sanitized_launch": { "$ref": "#/$defs/walkaroundProof" },
        "mission_control": { "$ref": "#/$defs/walkaroundProof" },
        "bundled_console": { "$ref": "#/$defs/walkaroundProof" },
        "start_here": { "$ref": "#/$defs/walkaroundProof" },
        "update": { "$ref": "#/$defs/walkaroundProof" },
        "rollback": { "$ref": "#/$defs/walkaroundProof" },
        "reattach": { "$ref": "#/$defs/walkaroundProof" },
        "one_outer_writer": { "$ref": "#/$defs/walkaroundProof" }
      }
    },
    "walkaroundReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "dmg_path",
        "dmg_sha256",
        "dmg_size",
        "mount_path",
        "app_path",
        "product_manifest_sha256",
        "source_revisions",
        "proofs",
        "delivery_seal"
      ],
      "properties": {
        "schema": {
          "const": "io.vetcoders.vibecrafted.walkaround.v1"
        },
        "dmg_path": {
          "type": "string",
          "pattern": "^/"
        },
        "dmg_sha256": { "$ref": "#/$defs/sha256" },
        "dmg_size": {
          "type": "integer",
          "minimum": 1
        },
        "mount_path": {
          "type": "string",
          "pattern": "^/"
        },
        "app_path": {
          "type": "string",
          "pattern": "^/"
        },
        "product_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "source_revisions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vibecrafted", "vc-terminal", "vc-frame"],
          "properties": {
            "vibecrafted": { "$ref": "#/$defs/gitSha" },
            "vc-terminal": { "$ref": "#/$defs/gitSha" },
            "vc-frame": { "$ref": "#/$defs/gitSha" }
          }
        },
        "proofs": { "$ref": "#/$defs/walkaroundProofs" },
        "delivery_seal": { "$ref": "#/$defs/proofArtifact" }
      }
    }
  }
}
