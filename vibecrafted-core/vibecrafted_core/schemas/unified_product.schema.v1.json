{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io.vetcoders.vibecrafted.contracts.v1",
  "title": "Unified Vibecrafted Product Contracts v1",
  "description": "Fail-closed manifests for unsigned modules, the assembled app, atomic activation, and the mounted-DMG walk-around.",
  "oneOf": [
    { "$ref": "#/$defs/moduleManifest" },
    { "$ref": "#/$defs/productManifest" },
    { "$ref": "#/$defs/transactionReceipt" },
    { "$ref": "#/$defs/walkaroundReceipt" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "architecture": {
      "const": "arm64"
    },
    "minimumMacos": {
      "type": "string",
      "pattern": "^(?:1[4-9]|[2-9][0-9])\\.[0-9]+$"
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "mode", "kind", "size", "dylibs"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mode": {
          "type": "string",
          "pattern": "^0[0-7]{3}$"
        },
        "kind": {
          "enum": ["executable", "dylib", "resource", "config"]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "dylibs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "moduleManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "module",
        "version",
        "git_sha",
        "dirty",
        "architecture",
        "minimum_macos",
        "files",
        "entrypoints"
      ],
      "properties": {
        "schema": {
          "const": "io.vetcoders.vibecrafted.module.v1"
        },
        "module": {
          "enum": ["vc-terminal", "vc-frame"]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "git_sha": { "$ref": "#/$defs/gitSha" },
        "dirty": { "type": "boolean" },
        "architecture": { "$ref": "#/$defs/architecture" },
        "minimum_macos": { "$ref": "#/$defs/minimumMacos" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fileEntry" }
        },
        "entrypoints": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["terminal"],
              "properties": {
                "terminal": { "$ref": "#/$defs/relativePath" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["frame"],
              "properties": {
                "frame": { "$ref": "#/$defs/relativePath" }
              }
            }
          ]
        }
      }
    },
    "moduleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "manifest_sha256", "git_sha"],
      "properties": {
        "module": {
          "enum": ["vc-terminal", "vc-frame"]
        },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "git_sha": { "$ref": "#/$defs/gitSha" }
      }
    },
    "productManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "product",
        "bundle_id",
        "bundle_executable",
        "version",
        "git_sha",
        "dirty",
        "architecture",
        "minimum_macos",
        "modules",
        "files",
        "entrypoints"
      ],
      "properties": {
        "schema": {
          "const": "io.vetcoders.vibecrafted.product.v1"
        },
        "product": { "const": "Vibecrafted" },
        "bundle_id": { "const": "io.vetcoders.vibecrafted" },
        "bundle_executable": { "const": "Vibecrafted" },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "git_sha": { "$ref": "#/$defs/gitSha" },
        "dirty": { "type": "boolean" },
        "architecture": { "$ref": "#/$defs/architecture" },
        "minimum_macos": { "$ref": "#/$defs/minimumMacos" },
        "modules": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/moduleBinding" }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fileEntry" }
        },
        "entrypoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["app", "terminal", "frame"],
          "properties": {
            "app": { "$ref": "#/$defs/relativePath" },
            "terminal": { "$ref": "#/$defs/relativePath" },
            "frame": { "$ref": "#/$defs/relativePath" }
          }
        }
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "source_revision"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_revision": { "$ref": "#/$defs/gitSha" }
      }
    },
    "releasePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "runtime"],
      "properties": {
        "app": { "$ref": "#/$defs/artifactIdentity" },
        "runtime": { "$ref": "#/$defs/artifactIdentity" }
      }
    },
    "transactionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "transaction_id",
        "previous",
        "new",
        "active",
        "outcome"
      ],
      "properties": {
        "schema": {
          "const": "io.vetcoders.vibecrafted.transaction.v1"
        },
        "transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "previous": { "$ref": "#/$defs/releasePair" },
        "new": { "$ref": "#/$defs/releasePair" },
        "active": { "$ref": "#/$defs/releasePair" },
        "outcome": {
          "enum": ["activated", "rolled_back"]
        }
      }
    },
    "walkaroundChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_app",
        "codesign",
        "app_notarization",
        "dmg_notarization",
        "gatekeeper",
        "sanitized_launch",
        "mission_control",
        "bundled_console",
        "start_here",
        "update",
        "rollback",
        "reattach",
        "one_outer_writer"
      ],
      "properties": {
        "one_app": { "const": true },
        "codesign": { "const": true },
        "app_notarization": { "const": true },
        "dmg_notarization": { "const": true },
        "gatekeeper": { "const": true },
        "sanitized_launch": { "const": true },
        "mission_control": { "const": true },
        "bundled_console": { "const": true },
        "start_here": { "const": true },
        "update": { "const": true },
        "rollback": { "const": true },
        "reattach": { "const": true },
        "one_outer_writer": { "const": true }
      }
    },
    "walkaroundReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "dmg_path",
        "dmg_sha256",
        "dmg_size",
        "product_manifest_sha256",
        "source_revisions",
        "checks"
      ],
      "properties": {
        "schema": {
          "const": "io.vetcoders.vibecrafted.walkaround.v1"
        },
        "dmg_path": {
          "type": "string",
          "pattern": "^/"
        },
        "dmg_sha256": { "$ref": "#/$defs/sha256" },
        "dmg_size": {
          "type": "integer",
          "minimum": 1
        },
        "product_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "source_revisions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vibecrafted", "vc-terminal", "vc-frame"],
          "properties": {
            "vibecrafted": { "$ref": "#/$defs/gitSha" },
            "vc-terminal": { "$ref": "#/$defs/gitSha" },
            "vc-frame": { "$ref": "#/$defs/gitSha" }
          }
        },
        "checks": { "$ref": "#/$defs/walkaroundChecks" }
      }
    }
  }
}
