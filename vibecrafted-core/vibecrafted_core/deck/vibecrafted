_gui_launch_notice() {
  local host="127.0.0.1"
  local port="0"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host)
        shift
        [[ $# -gt 0 ]] && host="$1"
        ;;
      --host=*)
        host="${1#--host=}"
        ;;
      --port)
        shift
        [[ $# -gt 0 ]] && port="$1"
        ;;
      --port=*)
        port="${1#--port=}"
        ;;
    esac
    shift || true
  done

  if [[ "$port" == "0" ]]; then
    printf '  Starting Vibecrafted control plane on %s:ephemeral.\n' "$host"
    printf '  The server will print its exact URL after binding. Press Ctrl-C to stop.\n'
    return 0
  fi

  printf '  Listening URL: http://%s:%s/\n' "$host" "$port"
  printf '  Press Ctrl-C to stop.\n'
}

