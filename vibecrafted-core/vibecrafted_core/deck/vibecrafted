# Resolve the interpreter that owns vibecrafted_core by reading the shebang
# from the uv-tool shim on PATH, since it carries the correct uv python.
_vibecrafted_python() {
  local resolved shebang py
  if [[ -n "${VIBECRAFTED_PYTHON:-}" && -x "$VIBECRAFTED_PYTHON" ]]; then
    printf '%s\n' "$VIBECRAFTED_PYTHON"
    return 0
  fi
  resolved="$(command -v vibecrafted 2>/dev/null || true)"
  if [[ -n "$resolved" && -f "$resolved" ]]; then
    shebang="$(head -n 1 "$resolved" 2>/dev/null || true)"
    if [[ "$shebang" =~ ^#\! ]]; then
      py="${shebang#\#!}"
      # Strip leading/trailing whitespace
      py="${py#"${py%%[![:space:]]*}"}"
      py="${py%"${py##*[![:space:]]}"}"
      if [[ -x "$py" ]]; then
        printf '%s\n' "$py"
        return 0
      fi
    fi
  fi
  command -v python3 2>/dev/null || command -v python 2>/dev/null || printf 'python3\n'
}

