cmd_resume() {
  local agent="${1:-}"
  if _is_help_flag "$agent"; then
    cmd_resume_help
    return 0
  fi
  [[ -n "$agent" ]] || {
    cmd_resume_help >&2
    return 1
  }
  shift || true
  if [[ "$agent" == "gemini" ]]; then
    printf '%b✗ gemini CLI is deprecated.%b Use agy (Google Antigravity CLI) instead.\n' "$_red" "$_reset" >&2
