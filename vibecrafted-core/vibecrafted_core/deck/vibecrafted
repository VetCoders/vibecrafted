cmd_start() {
  if _is_help_flag "${1:-}"; then
    cmd_start_help
    return 0
  fi
  local previous_repo_vc_frame_pref="${VIBECRAFTED_PREFER_REPO_VC_FRAME-}"
  local status
  _ensure_helpers_loaded || return 1
  export VIBECRAFTED_PREFER_REPO_VC_FRAME=1
  _run_helper vc-start "$@"
  status=$?
  if [[ -n "${previous_repo_vc_frame_pref}" ]]; then
    export VIBECRAFTED_PREFER_REPO_VC_FRAME="${previous_repo_vc_frame_pref}"
  else
    unset VIBECRAFTED_PREFER_REPO_VC_FRAME
  fi
  return "$status"
}

