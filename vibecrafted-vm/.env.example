# vc-workspace — non-secret env template. Copy to .env and fill in.
#   cp .env.example .env  &&  $EDITOR .env
# Secrets never belong here. Inject them in the launch process environment.

# ── Tailnet ─────────────────────────────────────────────────────────────────
# TAILSCALE_AUTHKEY is intentionally absent. Supply an ephemeral key through
# the process environment or your secret manager only when launching Compose.
# Node name on the tailnet (peers will: ssh root@<this>)
TAILSCALE_HOSTNAME=vc-workspace-host-a
# ACL tag — LEAVE BLANK unless you define the tag in your tailnet ACL AND add an
# ssh rule that matches tagged nodes. tag:devbox is NOT in the Vetcoders ACL, and
# tagging would bypass the autogroup:self ssh rule. Blank = user-owned node.
TAILSCALE_TAGS=

# ── Workspace mount ─────────────────────────────────────────────────────────
# Host path to the MULTIROOT repo tree, mounted at /workspace.
# host-a:        ~/.vibecrafted/vc-runtime      (default if left blank)
# shared volume: /Volumes/shared-vol/vc-runtime
# Upgrading? If your checkout still lives at the older ~/Libraxis/vc-runtime,
# set VC_RUNTIME_DIR to it — the compose default does not auto-detect it.
VC_RUNTIME_DIR=

# ── GPG signing (optional) ──────────────────────────────────────────────────
LOCTREE_GPG_KEY_ID=

# ── Misc ────────────────────────────────────────────────────────────────────
AICX_NO_MUTATION_WARN=0
TERM=xterm-256color
COLORTERM=truecolor

# 𝚅𝚒𝚋𝚎𝚌𝚛𝚊𝚏𝚝𝚎𝚍. with AI Agents by Vetcoders (c)2024-2026 LibraxisAI
