// operator — operator entrypoint (synced to vibecrafted standard)
// Launch: vibecrafted start | vc-start | vibecrafted dashboard operator
//
// CANON = same eye as built-in default_layout "vibecrafted"
// (zellij-utils/assets/layouts/vibecrafted.kdl, captured 2026-07-20):
//   • compact-bar brand + SESSIONS rail ALWAYS (default_tab_template)
//   • Guide (Mission Control) + vibecrafted shell
//   • no strider split — that was a parallel path; rejected as fleet standard
//
// default_tab_template (not new_tab_template): vc-frame 0.44 broke children
// inside new_tab_template; every tab — including agent tabs — inherits rail.
//
// Vibecrafted with AI Agents (c)2024-2026 LibraxisAI
layout {
    // Every tab: brand bar + SESSIONS rail (always visible) + content + status.
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="compact-bar" {
                brand_text " 𝚅𝚒𝚋𝚎𝚌𝚛𝚊𝚏𝚝𝚎𝚍. "
                brand_text_short " VC. "
            }
        }
        pane split_direction="vertical" {
            pane size=24 borderless=true {
                plugin location="session-manager" {
                    rail true
                    pane_title "Sessions"
                }
            }
            pane { children; }
        }
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    // Primary: Mission Control guide (same as default_layout vibecrafted).
    tab name="Guide" focus=true {
        pane name="VibeCrafted Shell Guide" {
            plugin location="about" {
                guide_mode "mission-control"
                pane_title "VibeCrafted Shell Guide"
            }
        }
    }

    // Operator shell — work surface; agents open as additional tabs (rail stays).
    tab name="vibecrafted" hide_floating_panes=true {
        pane command="/bin/zsh" name="operator" {
            args "-l"
            start_suspended true
        }
    }
}
